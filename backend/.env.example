# ═══════════════════════════════════════════
# AIStock Pro — 环境变量配置模板
# 复制为 .env 并填入你的 API Key
# ═══════════════════════════════════════════

# ───── 应用配置 ─────
APP_NAME=AIStock_Pro
DEBUG=True

# ───── MySQL 数据库 ─────
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=aistock_pro

# ───── AI 主模型：DeepSeek ─────
# 注册: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=true

# ───── AI 图像识别：豆包 (Doubao/Seed) ─────
# 注册: https://console.volcengine.com/
DOUBAO_API_KEY=ark-your-doubao-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-mini-260428

# ───── AI 图像识别备份：Gemini Vision ─────
# 注册: https://aistudio.google.com/
GEMINI_API_KEY=AIza-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ───── Web 搜索主：Brave Search ─────
# 注册: https://api.search.brave.com/ (免费 2000 次/月)
BRAVE_API_KEY=BSA-your-brave-api-key

# ───── Web 搜索备份：Tavily ─────
# 注册: https://tavily.com/ (免费 1000 次/月)
TAVILY_API_KEY=tvly-your-tavily-api-key

# ───── 金融数据：Tushare ─────
# 注册: https://tushare.pro/ (积分制)
TUSHARE_TOKEN=your-tushare-token

# ───── 代理配置 (Clash / 科学上网) ─────
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
